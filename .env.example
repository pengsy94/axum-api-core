# =============================================
# Axum Api Core - 环境变量配置
# 复制此文件为 .env 并修改为实际值
# 完整说明见 CONFIG.md
# =============================================

# ===== 环境 =====
# 运行环境：local / staging / production
# 设置后自动加载 .env.{APP_ENV} 文件（如 .env.local）
APP_ENV=local

# ===== 服务器 =====
# 调试模式（开启 /test 测试路由）
DEBUG=true
# 监听地址（留空 = 0.0.0.0）
SERVER_HOST=
# 监听端口（留空 = 3000）
SERVER_PORT=
# 是否启用 Gzip 压缩
SERVER_CONTENT_GZIP=true
# 是否启用定时任务
SERVER_CRON=false
# 是否开启 WebSocket
SERVER_WS_OPEN=false
# WebSocket 路径前缀
SERVER_WS_PATH=/ws
# 是否启用请求限流
SERVER_RATE_LIMIT_ENABLED=true
# CORS 允许的来源（* = 全部, 多个逗号分隔）
CORS_ALLOWED_ORIGINS=*
# JWT 签名密钥（生产环境务必改为随机字符串）
JWT_SECRET=change-me-to-a-random-secret

# ===== 日志 =====
# 日志级别：TRACE / DEBUG / INFO / WARN / ERROR
LOG_LEVEL=INFO
# 日志文件输出目录
LOG_DIR=logs
# 日志文件前缀（按小时滚动）
LOG_FILE=axum_log
# 是否记录请求/响应操作日志
LOG_ENABLE_OPER_LOG=true

# ===== 数据库 =====
# 连接字符串格式：mysql://user:password@host:port/database
DATABASE_URL=mysql://root:password@localhost:3306/database
# 连接池最大连接数
DATABASE_MAX_CONNECTIONS=10
# 连接池最小连接数（空闲保留）
DATABASE_MIN_CONNECTIONS=2
# 连接超时（秒）
DATABASE_CONNECT_TIMEOUT=30
